<style>
  :root {
    --cinematic-thumbnail: url("<%= basePath %>/storage/thumbnails/cinematic-frames");
  }
</style>
<link rel="manifest" href="<%= basePath %>/manifest.webmanifest" />
<link rel="icon" type="image/svg+xml" href="<%= basePath %>/icons/ai-hub.svg" />
<link rel="apple-touch-icon" href="<%= basePath %>/icons/ai-hub.svg" />
<script>
  window.__AI_HUB_BASE__ = "<%= basePath %>";
  if (window.__AI_HUB_BASE__) {
    const _origFetch = window.fetch;
    window.fetch = function(input, init) {
      if (typeof input === "string" && input.startsWith("/") && !input.startsWith(window.__AI_HUB_BASE__ + "/") && input !== window.__AI_HUB_BASE__) {
        input = window.__AI_HUB_BASE__ + input;
      }
      return _origFetch.call(this, input, init);
    };
  }
</script>
<script>
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => navigator.serviceWorker.register("<%= basePath %>/sw.js").catch(() => {}));
  }
</script>
<script src="<%= basePath %>/js/file-drop.js" defer></script>
<script src="<%= basePath %>/js/assignments.js" defer></script>
<script src="<%= basePath %>/js/notifications.js" defer></script>
<script src="<%= basePath %>/js/profile.js" defer></script>
<script src="<%= basePath %>/js/copy-text.js" defer></script>
