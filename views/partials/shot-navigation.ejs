<form id="shotNavigationForm" action="<%= basePath %>/" method="get" class="sticky top-[68px] z-20 mb-6 rounded-2xl border border-white/[0.09] bg-[#111315]/95 px-3 py-3 shadow-lg shadow-black/20 backdrop-blur-xl sm:px-4" aria-label="Filter shots by sequence and shot number">
  <div class="flex flex-wrap items-center gap-3">
    <div class="flex min-w-0 flex-1 items-center gap-3 sm:flex-none">
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-acid/15 bg-acid/[0.07] text-acid"><i data-lucide="scan-search" class="h-4 w-4"></i></span>
      <div class="min-w-0"><div class="text-xs font-semibold text-zinc-100">Find a shot</div><div class="mt-0.5 text-[10px] text-zinc-600">Use either number or both</div></div>
    </div>
    <div class="grid w-full min-w-0 gap-2 sm:ml-auto sm:flex sm:w-auto sm:items-center">
      <% if (!detail) { %><label class="group relative block min-w-0 sm:w-56 lg:w-64"><i data-lucide="search" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-500 transition group-focus-within:text-acid"></i><input id="searchInput" type="search" class="h-10 w-full rounded-xl border border-white/10 bg-black/25 pl-10 pr-10 text-sm text-white outline-none transition placeholder:text-zinc-600 hover:border-white/15 focus:border-acid/50 focus:bg-black/35 focus:ring-2 focus:ring-acid/10" placeholder="Search shots, models, tags…" aria-label="Search plans" /><kbd class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 rounded border border-white/10 bg-white/[0.04] px-1.5 py-0.5 text-[9px] font-medium text-zinc-600 sm:block">⌘K</kbd></label><% } %>
      <label class="flex min-w-0 items-center gap-2 rounded-xl border border-white/10 bg-black/25 pl-3 pr-1 transition focus-within:border-acid/50 focus-within:ring-2 focus-within:ring-acid/10 sm:w-44"><span class="shrink-0 text-[11px] font-bold text-acid">#Seq</span><input id="sequenceFilter" name="sequence_number" type="number" min="1" max="1000000" step="1" inputmode="numeric" class="number-filter h-10 w-full min-w-0 bg-transparent pr-2 text-right text-base font-semibold tabular-nums text-white outline-none placeholder:text-zinc-600" placeholder="Any" aria-label="Sequence number" value="<%= numberFilters.sequence_number || '' %>" /></label>
      <label class="flex min-w-0 items-center gap-2 rounded-xl border border-white/10 bg-black/25 pl-3 pr-1 transition focus-within:border-acid/50 focus-within:ring-2 focus-within:ring-acid/10 sm:w-44"><span class="shrink-0 text-[11px] font-bold text-acid">#Shot</span><input id="shotFilter" name="shot_number" type="number" min="1" max="1000000" step="1" inputmode="numeric" class="number-filter h-10 w-full min-w-0 bg-transparent pr-2 text-right text-base font-semibold tabular-nums text-white outline-none placeholder:text-zinc-600" placeholder="Any" aria-label="Plan or shot number" value="<%= numberFilters.shot_number || '' %>" /></label>
    </div>
    <div class="flex items-center gap-2"><% if (detail) { %><button type="submit" class="primary-button h-10 px-4 text-xs">View grid</button><% } %><button id="clearShotFilters" type="button" class="ghost-button h-10 px-3 text-xs"><i data-lucide="x" class="h-3.5 w-3.5"></i>Clear</button></div>
  </div>
  <div id="shotNavigationResults" class="mt-3 hidden max-h-32 overflow-y-auto border-t border-white/[0.07] pt-3" aria-live="polite"></div>
</form>
