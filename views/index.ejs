<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090a" />
    <meta name="description" content="AI Hub — cinematic AI media planning and review workspace" />
    <title>AI Hub · <%= project.title %></title>
    <link rel="stylesheet" href="<%= basePath %>/css/app.css" />
    <%- include('partials/base-head') %>
  </head>
  <body class="overflow-x-hidden">
    <div class="min-h-screen bg-[radial-gradient(circle_at_70%_-20%,rgba(214,255,69,0.06),transparent_32%)]">
      <aside class="app-sidebar fixed inset-y-0 left-0 z-40 flex w-[232px] flex-col border-r border-white/[0.07] bg-[#0b0c0e]/95 p-4 backdrop-blur-xl lg:translate-x-0">
        <div class="flex h-12 items-center gap-3 px-2">
          <div class="grid h-8 w-8 place-items-center rounded-xl bg-acid text-sm font-black text-black">A</div>
          <div>
            <div class="text-sm font-bold tracking-tight text-white">AI Hub</div>
            <div class="text-[9px] uppercase tracking-[0.2em] text-zinc-600">Production OS</div>
          </div>
        </div>

        <nav class="mt-6 space-y-1" aria-label="Main navigation">
          <a href="<%= basePath %>/" class="nav-item active" aria-current="page"><i data-lucide="layout-grid" class="h-[17px] w-[17px]"></i>Production</a>
          <a href="<%= basePath %>/prompt-library" class="nav-item"><i data-lucide="book-open" class="h-[17px] w-[17px]"></i>Prompt Library</a>
          <a href="<%= basePath %>/asset-library" class="nav-item"><i data-lucide="library" class="h-[17px] w-[17px]"></i>Asset Library</a>
        </nav>

        <div class="mt-7 px-3 text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-700">Workspace</div>
        <nav class="mt-2 space-y-1">
          <% if (permissions.canManageAccounts) { %>
          <button id="teamNavButton" class="nav-item"><i data-lucide="users" class="h-[17px] w-[17px]"></i>Accounts<span class="ml-auto rounded-full bg-acid/10 px-1.5 py-0.5 text-[8px] uppercase tracking-wider text-acid">Admin</span></button>
          <button id="catalogsNavButton" class="nav-item"><i data-lucide="sliders-horizontal" class="h-[17px] w-[17px]"></i>Generation settings</button>
          <% } %>
          <button type="button" class="nav-item" data-planned-feature="Activity" title="Planned feature"><i data-lucide="activity" class="h-[17px] w-[17px]"></i>Activity</button>
        </nav>

      </aside>

      <main class="min-h-screen lg:ml-[232px]">
        <header class="sticky top-0 z-30 flex h-[68px] items-center border-b border-white/[0.07] bg-[#08090a]/80 px-4 backdrop-blur-xl sm:px-6 xl:px-8">
          <button id="mobileMenuButton" class="icon-button mr-3 lg:hidden" aria-label="Open navigation"><i data-lucide="menu" class="h-4 w-4"></i></button>
          <div class="relative max-w-[420px] flex-1">
            <i data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-600"></i>
            <input id="searchInput" class="h-10 w-full rounded-full border border-transparent bg-white/[0.045] pl-10 pr-4 text-sm outline-none transition placeholder:text-zinc-600 focus:border-white/10 focus:bg-white/[0.065]" placeholder="Search plans, shots, models..." aria-label="Search plans" />
          </div>
          <div class="ml-auto flex items-center gap-2 pl-3">
            <button type="button" class="icon-button hidden sm:grid" aria-label="Notifications" data-planned-feature="Notifications" title="Planned feature"><i data-lucide="bell" class="h-4 w-4"></i></button>
            <% if (permissions.canCreatePlans) { %>
            <button id="newPlanButton" class="primary-button"><i data-lucide="plus" class="h-4 w-4"></i><span class="hidden sm:inline">New plan</span></button>
            <% } %>
            <div class="relative ml-1">
              <button id="accountButton" class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-amber-200 to-orange-700 text-xs font-bold text-black ring-2 ring-transparent transition hover:ring-white/20" aria-label="Open account menu"><%= currentUser.display_name.split(/\s+/).map(part => part[0]).join('').slice(0,2).toUpperCase() %></button>
              <div id="accountMenu" class="absolute right-0 top-12 z-50 hidden w-64 overflow-hidden rounded-2xl border border-white/10 bg-[#151619] p-2 shadow-float">
                <div class="border-b border-white/[0.07] px-3 py-3"><div class="truncate text-sm font-semibold text-zinc-200"><%= currentUser.display_name %></div><div class="mt-1 flex items-center gap-2 text-[10px] text-zinc-600"><span>@<%= currentUser.username %></span><span>·</span><span class="text-acid"><%= currentUser.role %></span></div></div>
                <% if (permissions.canManageAccounts) { %><button id="manageAccountsButton" class="nav-item mt-1"><i data-lucide="users-round" class="h-4 w-4"></i>Manage accounts</button><button id="manageCatalogsButton" class="nav-item"><i data-lucide="sliders-horizontal" class="h-4 w-4"></i>Generation settings</button><% } %>
                <button id="logoutButton" class="nav-item text-red-300/70 hover:text-red-200"><i data-lucide="log-out" class="h-4 w-4"></i>Sign out</button>
              </div>
            </div>
          </div>
        </header>

        <div class="px-4 pb-10 pt-7 sm:px-6 xl:px-8">
          <%- include('partials/shot-navigation', { numberFilters, detail: false }) %>
          <div class="flex flex-col justify-between gap-5 xl:flex-row xl:items-end">
            <div>
              <div class="mb-2 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-zinc-600">
                <span><%= project.code %></span><span class="h-1 w-1 rounded-full bg-zinc-700"></span><span>AI Production</span>
              </div>
              <h1 class="text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">Shots</h1>
              <p class="mt-2 max-w-xl text-sm leading-6 text-zinc-500"><%= project.description %></p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <select id="statusFilter" class="h-10 rounded-full border border-white/10 bg-[#0d0f12] pl-4 pr-9 text-xs font-medium text-zinc-300 outline-none transition hover:border-acid/40 focus:border-acid focus:text-acid focus:ring-2 focus:ring-acid/15">
                <option value="all">All statuses</option>
                <option value="WIP">WIP</option>
                <option value="Approved">Approved</option>
              </select>
            </div>
          </div>

          <section id="statsRow" class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/[0.07] bg-white/[0.07] lg:grid-cols-4">
          </section>

          <div class="mt-7 flex flex-wrap justify-between gap-2 text-xs text-zinc-500"><span id="shotResultCount" aria-live="polite"></span><span>Newest generation first · ungenerated shots use creation date</span></div>
          <section id="planGrid" aria-label="Shots" class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4"></section>
          <div id="emptyState" class="mt-16 hidden rounded-3xl border border-dashed border-white/10 py-16 text-center">
            <i data-lucide="search-x" class="mx-auto h-8 w-8 text-zinc-700"></i>
            <div class="mt-4 text-sm font-semibold">No plans found</div>
            <div class="mt-1 text-xs text-zinc-600">Change #Seq or #Shot, or clear the search and status filters.</div>
          </div>
        </div>
      </main>
    </div>

    <% if (permissions.canManageAccounts) { %>
    <div id="usersModal" class="pointer-events-none fixed inset-0 z-[65] hidden place-items-center p-4" aria-hidden="true">
      <button id="usersModalBackdrop" class="modal-backdrop absolute inset-0 bg-black/80" aria-label="Close account management"></button>
      <div id="usersModalCard" class="modal-card relative z-10 grid max-h-[92vh] w-full max-w-[1120px] overflow-y-auto rounded-3xl border border-white/10 bg-[#111214] shadow-float lg:grid-cols-[360px_1fr] lg:overflow-hidden">
        <section class="border-b border-white/[0.08] p-6 lg:overflow-y-auto lg:border-b-0 lg:border-r">
          <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-acid">Admin controls</div>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight">Create an account</h2>
          <p class="mt-2 text-xs leading-5 text-zinc-500">Create only a username and assign access. The user creates their own password on first sign-in.</p>
          <form id="newUserForm" class="mt-6 space-y-4">
            <label><span class="field-label">Display name</span><input name="display_name" class="field" placeholder="e.g. Sara Moradi" required /></label>
            <label><span class="field-label">Username</span><div class="relative"><span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-zinc-600">@</span><input name="username" class="field pl-8" placeholder="sara.m" pattern="[a-z0-9][a-z0-9._-]{2,31}" autocapitalize="none" required /></div></label>
            <label><span class="field-label">Role</span><select name="role" class="field"><% workspaceRoles.forEach(role => { %><option <%= role.name === 'Generator' ? 'selected' : '' %>><%= role.name %></option><% }) %></select></label>
            <div id="roleDescription" class="rounded-xl border border-white/[0.07] bg-black/20 p-3 text-[11px] leading-5 text-zinc-600"></div>
            <button type="submit" class="primary-button h-11 w-full"><span>Create account</span><i data-lucide="user-plus" class="h-4 w-4"></i></button>
          </form>
          <div class="my-6 border-t border-white/[0.07]"></div>
          <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-acid">Custom access</div>
          <h3 class="mt-2 text-lg font-semibold">Define a role</h3>
          <form id="newRoleForm" class="mt-4 space-y-3">
            <label><span class="field-label">Role name</span><input name="name" class="field" maxlength="40" placeholder="e.g. Art Director" required /></label>
            <label><span class="field-label">Description</span><input name="description" class="field" maxlength="240" placeholder="What this role is responsible for" /></label>
            <fieldset class="grid grid-cols-2 gap-2 text-[10px] text-zinc-500">
              <label class="flex items-center gap-2"><input type="checkbox" name="can_create_plans" /> Create shots</label>
              <label class="flex items-center gap-2"><input type="checkbox" name="can_edit_plans" /> Edit generations</label>
              <label class="flex items-center gap-2"><input type="checkbox" name="can_delete_plans" /> Delete shots</label>
              <label class="flex items-center gap-2"><input type="checkbox" name="can_manage_workflow" /> Change workflow</label>
              <label class="flex items-center gap-2"><input type="checkbox" name="can_review_plans" /> Review shots</label>
              <label class="flex items-center gap-2"><input type="checkbox" name="can_manage_libraries" /> Manage libraries</label>
              <label class="col-span-2 flex items-center gap-2"><input type="checkbox" name="can_manage_accounts" /> Manage accounts and settings</label>
            </fieldset>
            <p class="text-[10px] leading-4 text-zinc-700">Approval stays exclusive to the built-in Admin and Supervisor roles.</p>
            <button type="submit" class="ghost-button h-10 w-full">Add custom role</button>
          </form>
        </section>
        <section class="min-h-0 p-6 lg:overflow-y-auto">
          <div class="flex items-start justify-between"><div><div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-zinc-600">Workspace access</div><h3 class="mt-2 text-xl font-semibold">Team accounts</h3></div><button id="closeUsersModalButton" class="icon-button" aria-label="Close"><i data-lucide="x" class="h-4 w-4"></i></button></div>
          <div id="usersList" class="mt-5 max-h-[330px] min-h-[220px] space-y-2 overflow-y-auto pr-1"></div>
          <div class="mt-7 max-h-[360px] overflow-y-auto border-t border-white/[0.07] pt-6 pr-1"><div class="flex items-center justify-between"><div><div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-zinc-600">Permission sets</div><h3 class="mt-1 text-lg font-semibold">Workspace roles</h3></div><span id="roleCount" class="text-[10px] text-zinc-600"></span></div><div id="rolesList" class="mt-4 space-y-2 pb-1"></div></div>
        </section>
      </div>
    </div>
    <% } %>

    <% if (permissions.canManageAccounts) { %>
    <div id="catalogsModal" class="pointer-events-none fixed inset-0 z-[66] hidden place-items-center p-4" aria-hidden="true">
      <button id="catalogsModalBackdrop" class="modal-backdrop absolute inset-0 bg-black/80" aria-label="Close generation settings"></button>
      <div id="catalogsModalCard" class="modal-card relative z-10 flex max-h-[92vh] w-full max-w-[1040px] flex-col overflow-hidden rounded-3xl border border-white/10 bg-[#111214] shadow-float">
        <header class="flex items-start justify-between border-b border-white/[0.07] px-6 py-5"><div><div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-acid">Admin controls</div><h2 class="mt-2 text-2xl font-semibold tracking-tight">Generation settings</h2><p class="mt-1 text-xs text-zinc-500">Manage future form options without changing historical shots or generations.</p></div><button id="closeCatalogsModalButton" class="icon-button" aria-label="Close"><i data-lucide="x" class="h-4 w-4"></i></button></header>
        <div class="flex gap-1 overflow-x-auto border-b border-white/[0.07] px-5 py-3"><button class="catalog-tab shot-tab active rounded-xl px-4 py-2 text-xs font-semibold" data-catalog="models">AI models</button><button class="catalog-tab shot-tab rounded-xl px-4 py-2 text-xs font-semibold text-zinc-600" data-catalog="platforms">Generation platforms</button><button class="catalog-tab shot-tab rounded-xl px-4 py-2 text-xs font-semibold text-zinc-600" data-catalog="resource_roles">Resource types</button></div>
        <div class="grid min-h-0 flex-1 overflow-y-auto lg:grid-cols-[320px_1fr]">
          <section class="border-b border-white/[0.07] p-5 lg:border-b-0 lg:border-r sm:p-6"><div id="catalogFormEyebrow" class="text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-600">Add AI model</div><form id="catalogItemForm" class="mt-5 space-y-4"><label><span class="field-label">Name</span><input name="name" class="field" maxlength="100" required /></label><label id="catalogPriceField" class="hidden"><span class="field-label">Price per token ($)</span><input name="token_price" type="number" min="0" step="0.000001" class="field" value="0" /><span class="mt-2 block text-[10px] leading-4 text-zinc-700">Saved generations keep this price as a permanent snapshot.</span></label><button type="submit" class="primary-button h-11 w-full"><i data-lucide="plus" class="h-4 w-4"></i><span>Add option</span></button></form><div class="mt-5 rounded-2xl border border-white/[0.06] bg-black/20 p-4 text-[11px] leading-5 text-zinc-600"><i data-lucide="history" class="mr-1 inline h-3.5 w-3.5 text-acid"></i>Renaming or removing an option never rewrites an existing generation. Output remains a protected core resource type.</div></section>
          <section class="min-h-0 p-5 sm:p-6"><div class="flex items-center justify-between"><div><div id="catalogListEyebrow" class="text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-600">Available models</div><h3 id="catalogListTitle" class="mt-1 text-lg font-semibold">AI model catalog</h3></div><span id="catalogItemCount" class="rounded-full border border-white/[0.08] px-3 py-1.5 text-[10px] text-zinc-600"></span></div><div id="catalogItemsList" class="mt-5 space-y-2"></div></section>
        </div>
      </div>
    </div>
    <% } %>

    <div id="newPlanModal" class="pointer-events-none fixed inset-0 z-[60] hidden place-items-center p-4" aria-hidden="true">
      <button id="modalBackdrop" class="modal-backdrop absolute inset-0 bg-black/75" aria-label="Close new plan form"></button>
      <div id="modalCard" class="modal-card relative z-10 max-h-[92vh] w-full max-w-[760px] overflow-y-auto rounded-3xl border border-white/10 bg-[#111214] p-5 shadow-float sm:p-7">
        <div class="flex items-start justify-between">
          <div><div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-acid">New production item</div><h2 class="mt-1 text-2xl font-semibold tracking-tight">Create AI Plan</h2></div>
          <button id="closeModalButton" class="icon-button" aria-label="Close"><i data-lucide="x" class="h-4 w-4"></i></button>
        </div>
        <form id="newPlanForm" class="mt-7 grid gap-5 sm:grid-cols-2">
          <label><span class="field-label">#Seq · Sequence number *</span><input name="sequence_number" type="number" min="1" max="1000000" step="1" class="field text-2xl" required /></label>
          <label><span class="field-label">#Shot · Plan / Shot number *</span><input name="shot_number" type="number" min="1" max="1000000" step="1" class="field text-2xl" required /></label>
          <p class="text-xs text-zinc-500 sm:col-span-2">Both numbers are required and locked after creation. Every generation and uploaded file belongs to this numbered shot.</p>
          <label class="sm:col-span-2"><span class="field-label">Plan title *</span><input name="title" class="field" placeholder="e.g. Signal discovery" required /></label>
          <label class="sm:col-span-2"><span class="field-label">Brief / Notes</span><textarea name="description" class="field min-h-32 resize-y text-sm leading-6" maxlength="20000" placeholder="Describe the shot, creative intent, requirements, continuity notes, or anything the team should know."></textarea></label>
          <div class="sm:col-span-2 rounded-3xl border border-white/[0.08] bg-black/20 p-4 sm:p-5">
            <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_220px]">
              <label><span class="field-label">Upload Assets / Media</span><input id="newPlanAssetInput" name="assets" type="file" multiple class="field p-2 text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-2 file:text-xs file:font-semibold file:text-zinc-300" /><span id="newPlanAssetStatus" class="mt-2 block text-[10px] text-zinc-700">You can select multiple files. They will be attached after the plan is created.</span></label>
              <label><span class="field-label">Asset / Media type</span><select id="newPlanAssetRole" name="asset_role" class="field"><% generationCatalogs.resource_roles.forEach(role => { %><option <%= role.name === 'First Frame' ? 'selected' : '' %>><%= role.name %></option><% }) %></select></label>
            </div>
          </div>
          <div class="flex items-center justify-end gap-3 sm:col-span-2">
            <button type="button" id="cancelModalButton" class="ghost-button">Cancel</button>
            <button type="submit" class="primary-button px-6"><span>Create plan</span><i data-lucide="arrow-right" class="h-4 w-4"></i></button>
          </div>
        </form>
      </div>
    </div>

    <% if (permissions.canEditPlans) { %>
    <div id="coverModal" class="pointer-events-none fixed inset-0 z-[68] hidden place-items-center p-4" aria-hidden="true">
      <button id="coverModalBackdrop" class="modal-backdrop absolute inset-0 bg-black/80" aria-label="Close cover editor"></button>
      <div id="coverModalCard" class="modal-card relative z-10 max-h-[92vh] w-full max-w-[820px] overflow-y-auto rounded-3xl border border-white/10 bg-[#111214] shadow-float">
        <header class="flex items-start justify-between border-b border-white/[0.07] px-5 py-4 sm:px-6"><div><div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-acid">Plan card</div><h2 id="coverModalTitle" class="mt-1 text-xl font-semibold">Choose cover art</h2><p class="mt-1 text-xs text-zinc-500">Drag the image to reposition it, then adjust the crop with the zoom control.</p></div><button id="closeCoverModalButton" class="icon-button" aria-label="Close"><i data-lucide="x" class="h-4 w-4"></i></button></header>
        <div class="p-5 sm:p-6">
          <div class="overflow-hidden rounded-2xl border border-white/[0.08] bg-[#0d0f12]">
            <canvas id="coverCropCanvas" width="1280" height="720" class="aspect-video w-full touch-none cursor-grab"></canvas>
          </div>
          <div id="coverCropEmpty" class="pointer-events-none -mt-[56.25%] flex aspect-video items-center justify-center text-center"><div><i data-lucide="image-plus" class="mx-auto h-8 w-8 text-zinc-700"></i><div class="mt-3 text-sm font-semibold text-zinc-400">Choose an image to start</div><div class="mt-1 text-[11px] text-zinc-700">JPEG, PNG, WebP, GIF, or AVIF</div></div></div>
          <input id="coverFileInput" type="file" accept="image/*" class="hidden" />
          <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-end">
            <button id="chooseCoverImageButton" type="button" class="ghost-button h-11 shrink-0 px-4"><i data-lucide="upload" class="h-4 w-4"></i>Choose image</button>
            <label class="min-w-0 flex-1"><span class="field-label">Crop zoom</span><input id="coverZoomInput" type="range" min="1" max="3" value="1" step="0.01" disabled class="w-full accent-lime-300" /></label>
          </div>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-white/[0.07] pt-5">
            <button id="removeCustomCoverButton" type="button" class="hidden text-xs font-semibold text-red-300/70 transition hover:text-red-200"><i data-lucide="rotate-ccw" class="mr-1 inline h-3.5 w-3.5"></i>Use automatic cover</button>
            <div class="ml-auto flex gap-2"><button id="cancelCoverModalButton" type="button" class="ghost-button h-10 px-4">Cancel</button><button id="saveCoverButton" type="button" disabled class="primary-button h-10 px-5"><span>Save cover</span></button></div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <div id="toast" class="pointer-events-none fixed bottom-5 left-1/2 z-[70] flex -translate-x-1/2 translate-y-4 items-center gap-2 rounded-full border border-white/10 bg-zinc-100 px-4 py-2.5 text-xs font-semibold text-black opacity-0 shadow-float transition-all"><i data-lucide="check" class="h-4 w-4"></i><span></span></div>

    <script>
      window.__AI_HUB_PLANS__ = <%- serializedPlans %>;
      window.__AI_HUB_CURRENT_USER__ = <%- serializedUser %>;
      window.__AI_HUB_PERMISSIONS__ = <%- serializedPermissions %>;
      window.__AI_HUB_ROLES__ = <%- JSON.stringify(roleDefinitions).replaceAll('<', '\\u003c') %>;
      window.__AI_HUB_WORKSPACE_ROLES__ = <%- JSON.stringify(workspaceRoles).replaceAll('<', '\\u003c') %>;
      window.__AI_HUB_GENERATION_CATALOGS__ = <%- JSON.stringify(generationCatalogs).replaceAll('<', '\\u003c') %>;
    </script>
    <script src="<%= basePath %>/vendor/lucide/lucide.js"></script>
    <script src="<%= basePath %>/js/shot-navigation.js" defer></script>
    <script src="<%= basePath %>/js/app.js" defer></script>
  </body>
</html>
