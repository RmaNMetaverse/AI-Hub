<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090a" />
    <meta name="description" content="AI Hub prompt library" />
    <title>Prompt Library · AI Hub</title>
    <link rel="stylesheet" href="<%= basePath %>/css/app.css" />
    <%- include('partials/base-head') %>
  </head>
  <body class="overflow-x-hidden">
    <div class="min-h-screen bg-[radial-gradient(circle_at_70%_-20%,rgba(214,255,69,0.06),transparent_32%)]">
      <aside class="app-sidebar fixed inset-y-0 left-0 z-40 flex w-[232px] flex-col border-r border-white/[0.07] bg-[#0b0c0e]/95 p-4 backdrop-blur-xl lg:translate-x-0">
        <a href="<%= basePath %>/" class="flex h-12 items-center gap-3 px-2"><div class="grid h-8 w-8 place-items-center rounded-xl bg-acid text-sm font-black text-black">AI</div><div><div class="text-sm font-bold tracking-tight text-white">AI Hub</div><div class="text-[9px] uppercase tracking-[0.2em] text-zinc-600">Production OS</div></div></a>
        <nav class="mt-6 space-y-1" aria-label="Main navigation"><a href="<%= basePath %>/" class="nav-item"><i data-lucide="layout-grid" class="h-[17px] w-[17px]"></i>Production</a><a href="<%= basePath %>/prompt-library" class="nav-item active" aria-current="page"><i data-lucide="book-open" class="h-[17px] w-[17px]"></i>Prompt Library</a><a href="<%= basePath %>/asset-library" class="nav-item"><i data-lucide="library" class="h-[17px] w-[17px]"></i>Asset Library</a></nav>
        <div class="mt-7 px-3 text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-700">Workspace</div><nav class="mt-2 space-y-1"><a href="<%= basePath %>/reports" class="nav-item"><i data-lucide="chart-no-axes-combined" class="h-[17px] w-[17px]"></i>Reports</a><a href="<%= basePath %>/activity" class="nav-item"><i data-lucide="activity" class="h-[17px] w-[17px]"></i>Activity</a></nav>
        <div class="mt-auto rounded-2xl border border-white/[0.08] bg-white/[0.025] p-3.5"><div class="text-xs font-semibold text-zinc-300"><%= currentUser.display_name %></div><div class="mt-1 text-[10px] text-acid"><%= currentUser.role %></div><button class="library-logout mt-3 text-[10px] text-zinc-600 hover:text-white">Sign out</button></div>
      </aside>

      <main class="min-h-screen lg:ml-[232px]">
        <header class="sticky top-0 z-30 flex h-[68px] items-center border-b border-white/[0.07] bg-[#08090a]/80 px-4 backdrop-blur-xl sm:px-6 xl:px-8"><button class="library-mobile-menu icon-button mr-3 lg:hidden" aria-label="Open navigation"><i data-lucide="menu" class="h-4 w-4"></i></button><div class="relative max-w-[520px] flex-1"><i data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-600"></i><input id="librarySearch" class="h-10 w-full rounded-full border border-transparent bg-white/[0.045] pl-10 pr-4 text-sm outline-none transition placeholder:text-zinc-600 focus:border-white/10" placeholder="Search prompts, tags, and creators..." /></div><% if (permissions.canManageLibraries) { %><button id="addLibraryItem" class="primary-button ml-3"><i data-lucide="plus" class="h-4 w-4"></i><span class="hidden sm:inline">Add prompt</span></button><% } %></header>
        <div class="px-4 pb-12 pt-8 sm:px-6 xl:px-8"><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-acid">Reusable creative knowledge</div><h1 class="mt-2 text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">Prompt Library</h1><p class="mt-2 max-w-2xl text-sm leading-6 text-zinc-500">Keep proven prompts with the images, videos, documents, and other examples that explain the intended result.</p></div><span id="libraryCount" class="text-xs text-zinc-600"></span></div><section id="libraryGrid" class="mt-8 grid gap-4 md:grid-cols-2 2xl:grid-cols-3"></section><div id="libraryEmpty" class="mt-14 hidden rounded-3xl border border-dashed border-white/10 py-16 text-center"><i data-lucide="book-dashed" class="mx-auto h-8 w-8 text-zinc-700"></i><div class="mt-4 text-sm font-semibold">No prompts found</div><div class="mt-1 text-xs text-zinc-600">Add a prompt or change your search.</div></div></div>
      </main>
    </div>

    <% if (permissions.canManageLibraries) { %>
    <div id="libraryModal" class="modal-backdrop fixed inset-0 z-[60] hidden items-center justify-center bg-black/80 p-4"><form id="libraryForm" class="modal-card max-h-[92vh] w-full max-w-2xl overflow-y-auto rounded-3xl border border-white/10 bg-[#111214] p-6 shadow-float"><div class="flex items-start justify-between"><div><div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-acid">Prompt Library</div><h2 class="mt-2 text-2xl font-semibold">Add a reusable prompt</h2></div><button type="button" class="library-modal-close icon-button"><i data-lucide="x" class="h-4 w-4"></i></button></div><div class="mt-6 space-y-4"><label><span class="field-label">Title *</span><input name="title" class="field" maxlength="160" required /></label><label><span class="field-label">Tags</span><input name="tags" class="field" placeholder="cinematic, exterior, night" /></label><label><span class="field-label">Prompt *</span><textarea name="prompt" class="field min-h-40 resize-y text-xs leading-6" maxlength="30000" required></textarea></label><label><span class="field-label">Negative prompt</span><textarea name="negative_prompt" class="field min-h-24 resize-y text-xs" maxlength="15000"></textarea></label><label><span class="field-label">Example assets</span><input name="files" type="file" multiple class="field py-2 text-xs" /><span class="mt-2 block text-[10px] text-zinc-700">Images, videos, audio, PDFs, and other files. Up to <%= Math.round(maxUploadBytes / 1024 / 1024 / 1024) %> GB each.</span></label></div><div class="mt-6 flex justify-end gap-2"><button type="button" class="library-modal-close ghost-button">Cancel</button><button type="submit" class="primary-button"><i data-lucide="save" class="h-4 w-4"></i><span>Save prompt</span></button></div></form></div>
    <input id="promptAssetPicker" type="file" multiple class="hidden" />
    <% } %>
    <div id="libraryMediaViewer" class="modal-backdrop fixed inset-0 z-[75] hidden items-center justify-center bg-black/90 p-3 sm:p-6" role="dialog" aria-modal="true" aria-labelledby="libraryMediaViewerTitle"><div class="modal-card flex max-h-[95vh] w-full max-w-6xl flex-col overflow-hidden rounded-3xl border border-white/10 bg-[#0c0d0f] shadow-float"><header class="flex shrink-0 items-center justify-between gap-3 border-b border-white/[0.08] px-4 py-3 sm:px-5"><h2 id="libraryMediaViewerTitle" class="truncate text-sm font-semibold text-white"></h2><div class="flex items-center gap-2"><a id="libraryMediaViewerDownload" class="ghost-button h-9 px-3 text-xs" href="#"><i data-lucide="download" class="h-4 w-4"></i><span>Download</span></a><button id="libraryMediaViewerClose" type="button" class="icon-button" aria-label="Close"><i data-lucide="x" class="h-4 w-4"></i></button></div></header><div id="libraryMediaViewerBody" class="flex min-h-0 flex-1 items-center justify-center overflow-auto bg-black/70 p-4"></div><footer class="flex shrink-0 justify-center border-t border-white/[0.08] bg-black/30 px-4 py-3"><button id="libraryMediaViewerFullscreen" type="button" class="ghost-button h-9 px-4 text-xs"><i data-lucide="maximize-2" class="h-3.5 w-3.5"></i>Full screen</button></footer></div></div>
    <div id="libraryToast" class="pointer-events-none fixed bottom-5 left-1/2 z-[80] flex -translate-x-1/2 translate-y-4 items-center gap-2 rounded-full border border-white/10 bg-zinc-100 px-4 py-2.5 text-xs font-semibold text-black opacity-0 shadow-float transition-all"><i data-lucide="check" class="h-4 w-4"></i><span></span></div>
    <script>window.__AI_HUB_LIBRARY_TYPE__="prompts";window.__AI_HUB_LIBRARY_ITEMS__=<%- serializedPrompts %>;window.__AI_HUB_PERMISSIONS__=<%- serializedPermissions %>;window.__AI_HUB_MAX_UPLOAD_BYTES__=<%= maxUploadBytes %>;</script>
    <script src="<%= basePath %>/vendor/lucide/lucide.js"></script><script src="<%= basePath %>/js/library.js" defer></script>
  </body>
</html>
