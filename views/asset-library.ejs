<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#08090a" /><meta name="description" content="AI Hub asset library" /><title>Asset Library · AI Hub</title><link rel="stylesheet" href="<%= basePath %>/css/app.css" /><%- include('partials/base-head') %></head>
  <body class="overflow-x-hidden">
    <div class="min-h-screen bg-[radial-gradient(circle_at_70%_-20%,rgba(214,255,69,0.06),transparent_32%)]">
      <aside class="app-sidebar fixed inset-y-0 left-0 z-40 flex w-[232px] flex-col border-r border-white/[0.07] bg-[#0b0c0e]/95 p-4 backdrop-blur-xl lg:translate-x-0"><a href="<%= basePath %>/" class="flex h-12 items-center gap-3 px-2"><div class="grid h-8 w-8 place-items-center rounded-xl bg-acid text-sm font-black text-black">A</div><div><div class="text-sm font-bold tracking-tight text-white">AI Hub</div><div class="text-[9px] uppercase tracking-[0.2em] text-zinc-600">Production OS</div></div></a><nav class="mt-6 space-y-1"><a href="<%= basePath %>/" class="nav-item"><i data-lucide="layout-grid" class="h-[17px] w-[17px]"></i>Production</a><a href="<%= basePath %>/prompt-library" class="nav-item"><i data-lucide="book-open" class="h-[17px] w-[17px]"></i>Prompt Library</a><a href="<%= basePath %>/asset-library" class="nav-item active" aria-current="page"><i data-lucide="library" class="h-[17px] w-[17px]"></i>Asset Library</a></nav><div class="mt-7 px-3 text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-700">Workspace</div><nav class="mt-2"><button type="button" class="nav-item" data-planned-feature="Activity"><i data-lucide="activity" class="h-[17px] w-[17px]"></i>Activity</button></nav><div class="mt-auto rounded-2xl border border-white/[0.08] bg-white/[0.025] p-3.5"><div class="text-xs font-semibold text-zinc-300"><%= currentUser.display_name %></div><div class="mt-1 text-[10px] text-acid"><%= currentUser.role %></div><button class="library-logout mt-3 text-[10px] text-zinc-600 hover:text-white">Sign out</button></div></aside>
      <main class="min-h-screen lg:ml-[232px]"><header class="sticky top-0 z-30 flex h-[68px] items-center gap-2 border-b border-white/[0.07] bg-[#08090a]/80 px-4 backdrop-blur-xl sm:px-6 xl:px-8"><button class="library-mobile-menu icon-button shrink-0 lg:hidden"><i data-lucide="menu" class="h-4 w-4"></i></button><div class="relative min-w-0 max-w-[500px] flex-1"><i data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-600"></i><input id="librarySearch" class="h-10 w-full rounded-full border border-transparent bg-white/[0.045] pl-10 pr-4 text-sm outline-none placeholder:text-zinc-600 focus:border-white/10" placeholder="Search names, descriptions, tags, or files..." /></div><select class="asset-category-filter hidden h-10 rounded-full border border-white/10 bg-[#0d0f12] pl-4 pr-9 text-xs text-zinc-300 outline-none transition hover:border-acid/40 focus:border-acid focus:text-acid md:block"><option value="all">All categories</option><% assetCategories.forEach(category => { %><option><%= category %></option><% }) %></select><select class="asset-kind-filter hidden h-10 rounded-full border border-white/10 bg-[#0d0f12] pl-4 pr-9 text-xs text-zinc-300 outline-none transition hover:border-acid/40 focus:border-acid focus:text-acid xl:block"><option value="all">All file types</option><option value="image">Images</option><option value="video">Videos</option><option value="audio">Audio</option><option value="document">Documents</option><option value="archive">Archives</option><option value="other">Other</option></select><% if (permissions.canManageLibraries) { %><button id="addLibraryItem" class="primary-button shrink-0"><i data-lucide="upload-cloud" class="h-4 w-4"></i><span class="hidden sm:inline">Upload asset</span></button><% } %></header>
        <div class="px-4 pb-12 pt-8 sm:px-6 xl:px-8"><div class="mb-5 flex gap-2 md:hidden"><select class="asset-category-filter field h-10 py-0 pl-3.5 pr-8 text-xs"><option value="all">All categories</option><% assetCategories.forEach(category => { %><option><%= category %></option><% }) %></select><select class="asset-kind-filter field h-10 py-0 pl-3.5 pr-8 text-xs"><option value="all">All file types</option><option value="image">Images</option><option value="video">Videos</option><option value="audio">Audio</option><option value="document">Documents</option><option value="archive">Archives</option><option value="other">Other</option></select></div><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-acid">Shared production knowledge</div><h1 class="mt-2 text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">Asset Library</h1><p class="mt-2 max-w-2xl text-sm leading-6 text-zinc-500">Search character sheets, images, video tutorials, PDF documentation, references, audio, archives, and other files.</p></div><span id="libraryCount" class="text-xs text-zinc-600"></span></div><section id="libraryGrid" class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4"></section><div id="libraryEmpty" class="mt-14 hidden rounded-3xl border border-dashed border-white/10 py-16 text-center"><i data-lucide="package-search" class="mx-auto h-8 w-8 text-zinc-700"></i><div class="mt-4 text-sm font-semibold">No assets found</div><div class="mt-1 text-xs text-zinc-600">Change the filters or upload an asset.</div></div></div>
      </main>
    </div>
    <% if (permissions.canManageLibraries) { %><div id="libraryModal" class="modal-backdrop fixed inset-0 z-[60] hidden items-center justify-center bg-black/80 p-4"><form id="libraryForm" class="modal-card max-h-[92vh] w-full max-w-xl overflow-y-auto rounded-3xl border border-white/10 bg-[#111214] p-6 shadow-float"><div class="flex items-start justify-between"><div><div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-acid">Asset Library</div><h2 class="mt-2 text-2xl font-semibold">Upload an asset</h2></div><button type="button" class="library-modal-close icon-button"><i data-lucide="x" class="h-4 w-4"></i></button></div><div class="mt-6 space-y-4"><label><span class="field-label">File *</span><input name="file" type="file" class="field py-2 text-xs" required /></label><label><span class="field-label">Title *</span><input name="title" class="field" maxlength="160" required /></label><label><span class="field-label">Category *</span><select name="category" class="field"><% assetCategories.forEach(category => { %><option><%= category %></option><% }) %></select></label><label><span class="field-label">Tags</span><input name="tags" class="field" placeholder="hero, wardrobe, onboarding" /></label><label><span class="field-label">Description</span><textarea name="description" class="field min-h-28 resize-y text-xs" maxlength="3000"></textarea></label><p class="text-[10px] text-zinc-700">Maximum file size: <%= Math.round(maxUploadBytes / 1024 / 1024 / 1024) %> GB.</p></div><div class="mt-6 flex justify-end gap-2"><button type="button" class="library-modal-close ghost-button">Cancel</button><button type="submit" class="primary-button"><i data-lucide="upload-cloud" class="h-4 w-4"></i><span>Upload asset</span></button></div></form></div><% } %>
    <div id="libraryToast" class="pointer-events-none fixed bottom-5 left-1/2 z-[80] flex -translate-x-1/2 translate-y-4 items-center gap-2 rounded-full border border-white/10 bg-zinc-100 px-4 py-2.5 text-xs font-semibold text-black opacity-0 shadow-float transition-all"><i data-lucide="check" class="h-4 w-4"></i><span></span></div>
    <script>window.__AI_HUB_LIBRARY_TYPE__="assets";window.__AI_HUB_LIBRARY_ITEMS__=<%- serializedAssets %>;window.__AI_HUB_PERMISSIONS__=<%- serializedPermissions %>;window.__AI_HUB_MAX_UPLOAD_BYTES__=<%= maxUploadBytes %>;</script><script src="<%= basePath %>/vendor/lucide/lucide.js"></script><script src="<%= basePath %>/js/library.js" defer></script>
  </body>
</html>
