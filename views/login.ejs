<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090a" />
    <meta name="description" content="Sign in to AI Hub" />
    <title>Sign in · AI Hub</title>
    <link rel="stylesheet" href="<%= basePath %>/css/app.css" />
    <%- include('partials/base-head') %>
  </head>
  <body>
    <main class="grid min-h-screen bg-[#08090a] lg:grid-cols-[1.15fr_0.85fr]">
      <section class="relative hidden min-h-screen overflow-hidden border-r border-white/[0.07] lg:block">
        <div class="login-cinematic-backdrop absolute inset-0 scale-[1.02]"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-black/5 via-black/20 to-[#08090a]/90"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-black/30"></div>
        <div class="absolute left-10 top-9 flex items-center gap-3">
          <div class="grid h-9 w-9 place-items-center rounded-xl bg-acid text-sm font-black text-black">A</div>
          <div><div class="text-sm font-bold text-white">AI Hub</div><div class="text-[9px] uppercase tracking-[0.2em] text-white/45">Production OS</div></div>
        </div>
        <div class="absolute bottom-10 left-10 max-w-lg pr-10">
          <div class="mb-4 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-acid"><span class="h-px w-8 bg-acid"></span>Protected workspace</div>
          <h1 class="text-4xl font-semibold leading-[1.06] tracking-[-0.045em] text-white xl:text-5xl">Every frame has a history.<br />Keep it with the team.</h1>
          <p class="mt-5 max-w-md text-sm leading-6 text-white/50">Plan cinematic AI media, preserve every generation, and move final work through a clear review process.</p>
        </div>
      </section>

      <section class="flex min-h-screen items-center justify-center px-5 py-10 sm:px-10">
        <div class="w-full max-w-[420px]">
          <div class="mb-10 flex items-center gap-3 lg:hidden">
            <div class="grid h-9 w-9 place-items-center rounded-xl bg-acid text-sm font-black text-black">A</div>
            <div class="text-sm font-bold">AI Hub</div>
          </div>

          <div id="identifyStep">
            <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-acid">Team access</div>
            <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-white">Welcome to AI Hub</h2>
            <p class="mt-3 text-sm leading-6 text-zinc-500">Enter the username your Admin created for you.</p>
            <form id="identifyForm" class="mt-8">
              <label><span class="field-label">Username</span><div class="relative"><i data-lucide="at-sign" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-600"></i><input id="usernameInput" name="username" class="field h-12 pl-11" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="your.username" required /></div></label>
              <button type="submit" class="primary-button mt-5 h-12 w-full"><span>Continue</span><i data-lucide="arrow-right" class="h-4 w-4"></i></button>
            </form>
          </div>

          <div id="passwordStep" class="hidden">
            <button class="back-button mb-7 flex items-center gap-2 text-xs text-zinc-500 transition hover:text-white"><i data-lucide="arrow-left" class="h-4 w-4"></i>Use another account</button>
            <div class="flex items-center gap-3"><div id="passwordAvatar" class="grid h-11 w-11 place-items-center rounded-full bg-white/10 text-xs font-bold"></div><div><div id="passwordName" class="text-sm font-semibold"></div><div id="passwordRole" class="mt-1 text-[10px] uppercase tracking-wider text-zinc-600"></div></div></div>
            <h2 class="mt-7 text-3xl font-semibold tracking-[-0.04em]">Enter your password</h2>
            <p class="mt-3 text-sm text-zinc-500">Your workspace is ready when you are.</p>
            <form id="passwordForm" class="mt-8">
              <label><span class="field-label">Password</span><div class="relative"><i data-lucide="lock-keyhole" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-600"></i><input id="passwordInput" type="password" name="password" class="field h-12 pl-11 pr-12" autocomplete="current-password" required /><button type="button" class="password-toggle absolute right-3 top-1/2 grid h-8 w-8 -translate-y-1/2 place-items-center text-zinc-600 hover:text-white" aria-label="Show password"><i data-lucide="eye" class="h-4 w-4"></i></button></div></label>
              <button type="submit" class="primary-button mt-5 h-12 w-full"><span>Sign in</span><i data-lucide="arrow-right" class="h-4 w-4"></i></button>
            </form>
          </div>

          <div id="setupStep" class="hidden">
            <button class="back-button mb-7 flex items-center gap-2 text-xs text-zinc-500 transition hover:text-white"><i data-lucide="arrow-left" class="h-4 w-4"></i>Use another account</button>
            <div class="inline-flex items-center gap-2 rounded-full border border-acid/20 bg-acid/[0.07] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-acid"><i data-lucide="sparkles" class="h-3.5 w-3.5"></i>First sign-in</div>
            <h2 class="mt-5 text-3xl font-semibold tracking-[-0.04em]">Secure your account</h2>
            <p class="mt-3 text-sm leading-6 text-zinc-500"><span id="setupName" class="text-zinc-300"></span>, create the password you’ll use from now on.</p>
            <form id="setupForm" class="mt-8 space-y-5">
              <label><span class="field-label">Create password</span><input id="newPasswordInput" type="password" name="password" class="field h-12" minlength="10" autocomplete="new-password" required /></label>
              <label><span class="field-label">Confirm password</span><input type="password" name="confirmation" class="field h-12" minlength="10" autocomplete="new-password" required /></label>
              <div class="rounded-xl border border-white/[0.07] bg-white/[0.025] p-3 text-[11px] leading-5 text-zinc-600"><span class="font-semibold text-zinc-400">Password requirement:</span> at least 10 characters. A longer phrase is easier to remember and safer.</div>
              <button type="submit" class="primary-button h-12 w-full"><span>Create password & sign in</span><i data-lucide="shield-check" class="h-4 w-4"></i></button>
            </form>
          </div>

          <div id="authError" class="mt-5 hidden items-start gap-2 rounded-xl border border-red-400/15 bg-red-400/[0.06] px-3.5 py-3 text-xs leading-5 text-red-200/80"><i data-lucide="circle-alert" class="mt-0.5 h-4 w-4 shrink-0"></i><span></span></div>
          <p class="mt-9 text-center text-[11px] leading-5 text-zinc-700">Accounts can only be created by an AI Hub Admin.</p>
        </div>
      </section>
    </main>
    <script src="<%= basePath %>/vendor/lucide/lucide.js"></script>
    <script src="<%= basePath %>/js/auth.js" defer></script>
  </body>
</html>
