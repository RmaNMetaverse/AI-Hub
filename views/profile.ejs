<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>My profile · AI Hub</title><link rel="stylesheet" href="<%= basePath %>/css/app.css" /><%- include('partials/base-head') %></head>
<body class="bg-[#08090a] text-white"><main class="mx-auto max-w-2xl px-5 py-10">
  <a href="<%= basePath %>/" class="ghost-button">Back to Production</a>
  <h1 class="mt-7 text-3xl font-semibold">My profile</h1><p class="mt-2 text-sm text-zinc-500"><%= currentUser.display_name %> · @<%= currentUser.username %></p>
  <section class="mt-7 rounded-3xl border border-white/10 bg-[#111214] p-6"><h2 class="text-lg font-semibold">Profile picture</h2><div class="mt-5 flex items-center gap-4"><div id="profileAvatar" class="grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-full bg-acid/10 text-xl font-semibold text-acid"><%= currentUser.display_name.slice(0,1) %></div><p class="text-xs leading-5 text-zinc-500">JPEG, PNG, WebP, or GIF. Maximum 5 MB.</p></div><form id="profileAvatarForm" class="mt-5 space-y-4"><input name="file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="field" required /><button class="primary-button" type="submit">Save picture</button></form></section>
  <section class="mt-5 rounded-3xl border border-white/10 bg-[#111214] p-6"><h2 class="text-lg font-semibold">Change password</h2><form id="profilePasswordForm" class="mt-5 space-y-4"><label class="block"><span class="field-label">Current password</span><input name="current_password" type="password" autocomplete="current-password" class="field" required maxlength="128" /></label><label class="block"><span class="field-label">New password</span><input name="password" type="password" autocomplete="new-password" class="field" required minlength="10" maxlength="128" /></label><label class="block"><span class="field-label">Confirm new password</span><input name="confirmation" type="password" autocomplete="new-password" class="field" required minlength="10" maxlength="128" /></label><p class="text-xs text-zinc-500">Use at least 10 characters. Other sessions will be signed out after your password changes.</p><button class="primary-button" type="submit">Change password</button></form></section>
  <p id="profileMessage" role="status" class="mt-5 text-sm text-acid"></p>
</main></body></html>
