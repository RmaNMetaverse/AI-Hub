<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090a" />
    <meta name="description" content="AI Hub workspace activity" />
    <title>Activity - AI Hub</title>
    <link rel="stylesheet" href="<%= basePath %>/css/app.css" />
    <%- include('partials/base-head') %>
  </head>
  <body>
    <% const actionLabel = value => String(value || '').split('_').map(word => word[0]?.toUpperCase() + word.slice(1)).join(' '); %>
    <div class="min-h-screen bg-[radial-gradient(circle_at_70%_-20%,rgba(214,255,69,0.06),transparent_32%)]">
      <aside class="app-sidebar fixed inset-y-0 left-0 z-40 flex w-[232px] flex-col border-r border-white/[0.07] bg-[#0b0c0e]/95 p-4 backdrop-blur-xl lg:translate-x-0">
        <a href="<%= basePath %>/" class="flex h-12 items-center gap-3 px-2"><div class="grid h-8 w-8 place-items-center rounded-xl bg-acid text-sm font-black text-black">AI</div><div><div class="text-sm font-bold tracking-tight text-white">AI Hub</div><div class="text-[9px] uppercase tracking-[0.2em] text-zinc-600">Production OS</div></div></a>
        <nav class="mt-6 space-y-1"><a href="<%= basePath %>/" class="nav-item"><i data-lucide="layout-grid" class="h-[17px] w-[17px]"></i>Production</a><a href="<%= basePath %>/prompt-library" class="nav-item"><i data-lucide="book-open" class="h-[17px] w-[17px]"></i>Prompt Library</a><a href="<%= basePath %>/asset-library" class="nav-item"><i data-lucide="library" class="h-[17px] w-[17px]"></i>Asset Library</a></nav>
        <div class="mt-7 px-3 text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-700">Workspace</div><nav class="mt-2 space-y-1"><a href="<%= basePath %>/reports" class="nav-item"><i data-lucide="chart-no-axes-combined" class="h-[17px] w-[17px]"></i>Reports</a><a href="<%= basePath %>/activity" class="nav-item active" aria-current="page"><i data-lucide="activity" class="h-[17px] w-[17px]"></i>Activity</a></nav>
        <div class="mt-auto px-3 py-2"><div class="truncate text-xs font-semibold text-zinc-300"><%= currentUser.display_name %></div><div class="mt-1 text-[10px] text-acid"><%= currentUser.role %></div><button class="workspace-logout mt-3 text-[10px] text-zinc-600 hover:text-white">Sign out</button></div>
      </aside>
      <div class="lg:pl-[232px]">
        <header class="sticky top-0 z-30 flex h-[68px] items-center border-b border-white/[0.07] bg-[#08090a]/85 px-4 backdrop-blur-xl sm:px-6 xl:px-8"><button class="workspace-mobile-menu icon-button mr-3 lg:hidden" aria-label="Open navigation"><i data-lucide="menu" class="h-4 w-4"></i></button><div><div class="text-sm font-semibold">Activity</div><div class="mt-0.5 text-[9px] uppercase tracking-[0.14em] text-zinc-700"><%= activities.length %> recent events</div></div><a href="<%= basePath %>/reports" class="ghost-button ml-auto h-9 px-3 text-xs"><i data-lucide="chart-no-axes-combined" class="h-3.5 w-3.5"></i>Reports</a></header>
        <main class="mx-auto max-w-[1300px] px-4 pb-16 pt-8 sm:px-6 xl:px-8">
          <div><div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-acid">Audit trail</div><h1 class="mt-2 text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">Workspace activity</h1><p class="mt-3 max-w-3xl text-sm leading-6 text-zinc-500">Creation, edits, uploads, deletions, status changes, sign-ins, and Supervisor approvals are recorded here.</p></div>
          <section class="mt-7 rounded-3xl border border-white/[0.07] bg-[#101113] p-4 sm:p-5"><div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_220px_220px]"><input id="activitySearch" class="field h-10 py-0 text-xs" placeholder="Search people, actions, plans, or details" /><select id="activityRoleFilter" class="field h-10 py-0 text-xs"><option value="all">All roles</option><% [...new Set(activities.map(item => item.actor_role))].sort().forEach(role => { %><option value="<%= role %>"><%= role %></option><% }) %></select><select id="activityTypeFilter" class="field h-10 py-0 text-xs"><option value="all">All activity types</option><% [...new Set(activities.map(item => item.entity_type))].sort().forEach(type => { %><option value="<%= type %>"><%= actionLabel(type) %></option><% }) %></select></div></section>
          <section id="activityList" class="mt-5 space-y-2">
            <% if (activities.length) { activities.forEach(item => { const initials = item.actor_name.split(/\s+/).map(part => part[0]).join('').slice(0,2).toUpperCase(); %>
              <article data-activity data-role="<%= item.actor_role %>" data-type="<%= item.entity_type %>" data-search="<%= (item.actor_name + ' ' + item.actor_role + ' ' + item.action + ' ' + item.entity_type + ' ' + item.summary + ' ' + (item.plan_title || '')).toLowerCase() %>" class="flex gap-4 rounded-2xl border border-white/[0.065] bg-[#101113] p-4 sm:p-5"><div class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white/[0.07] text-[10px] font-bold text-zinc-300"><%= initials %></div><div class="min-w-0 flex-1"><div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start"><div><div class="text-sm leading-6 text-zinc-300"><span class="font-semibold text-white"><%= item.actor_name %></span> <%= item.summary.replace(item.actor_name, '').trim() %></div><div class="mt-1 flex flex-wrap items-center gap-2 text-[9px] uppercase tracking-[0.1em] text-zinc-700"><span><%= item.actor_role %></span><span>·</span><span><%= actionLabel(item.action) %></span><span>·</span><span><%= actionLabel(item.entity_type) %></span></div></div><time class="shrink-0 text-[10px] text-zinc-700" datetime="<%= item.created_at %>"><%= item.created_at.slice(0,16).replace('T',' ') %></time></div><% if (item.plan_title) { %><a href="<%= basePath %>/plans/<%= item.plan_id %>" class="mt-3 inline-flex items-center gap-1.5 text-[10px] font-semibold text-acid hover:text-white"><i data-lucide="arrow-up-right" class="h-3 w-3"></i>#Seq <%= item.sequence_number %> / #Shot <%= item.shot_number %> · <%= item.plan_title %></a><% } %></div></article>
            <% }) } else { %><div class="rounded-3xl border border-dashed border-white/10 py-24 text-center"><i data-lucide="activity" class="mx-auto h-8 w-8 text-zinc-700"></i><div class="mt-4 text-sm font-semibold">No activity has been recorded yet</div><div class="mt-1 text-xs text-zinc-600">New workspace actions will appear here.</div></div><% } %>
          </section>
          <div id="activityEmpty" class="mt-5 hidden rounded-3xl border border-dashed border-white/10 py-20 text-center text-sm text-zinc-600">No activity matches these filters.</div>
        </main>
      </div>
    </div>
    <script>window.__AI_HUB_BASE__ = <%- JSON.stringify(basePath) %>;</script>
    <script src="<%= basePath %>/vendor/lucide/lucide.js"></script>
    <script src="<%= basePath %>/js/activity.js" defer></script>
  </body>
</html>
