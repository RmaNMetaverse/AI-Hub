<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090a" />
    <meta name="description" content="<%= plan.title %> - AI Hub shot workspace" />
    <title><%= plan.is_test_plan ? 'Test plan' : plan.shot_code %> · <%= plan.title %> - AI Hub</title>
    <link rel="stylesheet" href="<%= basePath %>/css/app.css" />
    <%- include('partials/base-head') %>
  </head>
  <body>
    <% const statusStyles = { WIP: 'border-amber-400/20 bg-amber-400/10 text-amber-300', Approved: 'border-lime-400/20 bg-lime-400/10 text-lime-300' }; %>
    <% const userInitials = currentUser.display_name.split(/\s+/).map(part => part[0]).join('').slice(0,2).toUpperCase(); %>
    <% const ownerInitials = plan.owner.split(/\s+/).map(part => part[0]).join('').slice(0,2).toUpperCase(); %>
    <% const formatBytes = bytes => { const value = Number(bytes || 0); if (!value) return '0 B'; const units = ['B','KB','MB','GB','TB']; const index = Math.min(Math.floor(Math.log(value) / Math.log(1024)), units.length - 1); return `${(value / (1024 ** index)).toFixed(index ? 1 : 0)} ${units[index]}`; }; %>
    <% const formatCost = value => Number(value || 0) > 0 ? `$${Number(value).toFixed(Number(value) < 0.01 ? 4 : 2)}` : 'Not tracked'; %>
    <% const resourceIcons = { image: 'image', video: 'file-video-2', audio: 'audio-lines', document: 'file-text', archive: 'archive', other: 'file-box' }; %>

    <div class="min-h-screen bg-[radial-gradient(circle_at_55%_-20%,rgba(214,255,69,0.055),transparent_35%)]">
      <header class="sticky top-0 z-40 flex h-[68px] items-center border-b border-white/[0.07] bg-[#08090a]/85 px-4 backdrop-blur-xl sm:px-6 xl:px-8">
        <a data-shot-navigation href="<%= basePath %>/<%= filterQuery ? '?' + filterQuery : '' %>" class="flex items-center gap-3" aria-label="AI Hub shot grid">
          <div class="grid h-8 w-8 place-items-center rounded-xl bg-acid text-sm font-black text-black">AI</div>
          <div class="hidden sm:block"><div class="text-sm font-bold tracking-tight">AI Hub</div><div class="text-[8px] uppercase tracking-[0.18em] text-zinc-700">Production OS</div></div>
        </a>
        <div class="mx-4 hidden h-6 w-px bg-white/[0.08] sm:block"></div>
        <a data-shot-navigation href="<%= basePath %>/<%= filterQuery ? '?' + filterQuery : '' %>" class="plan-header-back" aria-label="Back to Production"><i data-lucide="arrow-left" class="h-4 w-4"></i><span class="hidden sm:inline">Back to Production</span><span class="sm:hidden">Production</span></a>
        <div class="ml-auto flex items-center gap-2">
          <div class="hidden items-center rounded-full border border-white/[0.08] bg-white/[0.03] p-1 sm:flex">
            <a id="previousShot" href="<%= previousPlan ? basePath + '/plans/' + previousPlan.id : '#' %><%= previousPlan && filterQuery ? '?' + filterQuery : '' %>" class="icon-button h-8 w-8 border-0 bg-transparent <%= previousPlan ? '' : 'hidden' %>" title="<%= previousPlan ? 'Previous: ' + previousPlan.title : 'Previous shot' %>" aria-label="Previous shot"><i data-lucide="chevron-left" class="h-4 w-4"></i></a>
            <span class="px-2 text-[9px] font-semibold uppercase tracking-[0.12em] text-zinc-600">Shots</span>
            <a id="nextShot" href="<%= nextPlan ? basePath + '/plans/' + nextPlan.id : '#' %><%= nextPlan && filterQuery ? '?' + filterQuery : '' %>" class="icon-button h-8 w-8 border-0 bg-transparent <%= nextPlan ? '' : 'hidden' %>" title="<%= nextPlan ? 'Next: ' + nextPlan.title : 'Next shot' %>" aria-label="Next shot"><i data-lucide="chevron-right" class="h-4 w-4"></i></a>
          </div>
          <div class="relative">
            <button id="shotAccountButton" class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-amber-200 to-orange-700 text-xs font-bold text-black" aria-label="Open account menu"><%= userInitials %></button>
            <div id="shotAccountMenu" class="absolute right-0 top-12 hidden w-60 overflow-hidden rounded-2xl border border-white/10 bg-[#151619] p-2 shadow-float">
              <div class="border-b border-white/[0.07] px-3 py-3"><div class="truncate text-sm font-semibold"><%= currentUser.display_name %></div><div class="mt-1 text-[10px] text-zinc-600">@<%= currentUser.username %> &middot; <span class="text-acid"><%= currentUser.role %></span></div></div>
              <a data-shot-navigation href="<%= basePath %>/<%= filterQuery ? '?' + filterQuery : '' %>" class="nav-item mt-1"><i data-lucide="layout-grid" class="h-4 w-4"></i>Shot grid</a>
              <a href="<%= basePath %>/prompt-library" class="nav-item"><i data-lucide="book-open" class="h-4 w-4"></i>Prompt Library</a>
              <a href="<%= basePath %>/asset-library" class="nav-item"><i data-lucide="library" class="h-4 w-4"></i>Asset Library</a>
              <a href="<%= basePath %>/reports" class="nav-item"><i data-lucide="chart-no-axes-combined" class="h-4 w-4"></i>Reports</a>
              <a href="<%= basePath %>/activity" class="nav-item"><i data-lucide="activity" class="h-4 w-4"></i>Activity</a>
              <button id="shotLogoutButton" class="nav-item text-red-300/70 hover:text-red-200"><i data-lucide="log-out" class="h-4 w-4"></i>Sign out</button>
            </div>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-[1560px] px-4 pb-14 pt-5 sm:px-6 xl:px-8">
        <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
          <div>
            <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.15em] text-zinc-700">
              <a data-shot-navigation href="<%= basePath %>/<%= filterQuery ? '?' + filterQuery : '' %>" class="transition hover:text-zinc-400"><%= project.code %></a><i data-lucide="chevron-right" class="h-3 w-3"></i><span class="text-acid"><%= plan.is_test_plan ? 'Test plan' : `#Seq ${plan.sequence_number} · #Shot ${plan.shot_number}` %></span>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <h1 class="text-3xl font-semibold tracking-[-0.04em] sm:text-4xl"><%= plan.title %></h1>
              <span id="shotStatusPill" class="status-pill <%= statusStyles[plan.status] || statusStyles.WIP %>"><span class="h-1.5 w-1.5 rounded-full bg-current"></span><%= plan.status %></span>
            </div>
            <p class="mt-2 max-w-3xl text-sm leading-6 text-zinc-500"><%= plan.description || 'No creative brief has been added yet.' %></p>
          </div>
          <div class="flex flex-wrap items-center gap-2 text-[10px] text-zinc-600">
            <span class="rounded-full border border-white/[0.08] px-3 py-1.5"><%= plan.media_type %></span>
            <span class="rounded-full border border-white/[0.08] px-3 py-1.5"><%= plan.aspect_ratio %></span>
            <span class="rounded-full border border-white/[0.08] px-3 py-1.5"><%= plan.duration %></span>
            <% if (permissions.canDeletePlans) { %><button id="deleteShotButton" class="rounded-full border border-red-300/15 px-3 py-1.5 text-red-300/60 transition hover:border-red-300/30 hover:text-red-200"><i data-lucide="trash-2" class="mr-1 inline h-3 w-3"></i>Delete shot</button><% } %>
          </div>
        </div>

        <div class="sticky z-20 mt-5 flex items-center gap-1 overflow-x-auto rounded-2xl border border-white/[0.07] bg-[#0e0f11]/90 p-1.5 backdrop-blur-xl" style="top:calc(80px + var(--shot-navigation-height, 0px))">
          <button class="shot-tab active shrink-0 rounded-xl px-4 py-2 text-xs font-semibold" data-tab="generations"><i data-lucide="layers-3" class="mr-2 inline h-3.5 w-3.5"></i>Generations <span class="ml-1 rounded-full bg-white/[0.06] px-1.5 py-0.5 text-[9px]"><%= plan.generation_count %></span></button>
          <button class="shot-tab shrink-0 rounded-xl px-4 py-2 text-xs font-semibold text-zinc-600" data-tab="assets"><i data-lucide="library" class="mr-2 inline h-3.5 w-3.5"></i>Assets <span class="ml-1 rounded-full bg-white/[0.06] px-1.5 py-0.5 text-[9px]"><%= plan.resource_count %></span></button>
        </div>

        <div class="mt-5 grid items-start gap-5 xl:grid-cols-[minmax(0,1fr)_330px]">
          <div class="min-w-0">
            <section class="shot-panel" data-panel="generations">
              <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                <div><div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-600">Version history</div><h2 class="mt-2 text-2xl font-semibold tracking-tight">Generation timeline</h2><p class="mt-2 max-w-2xl text-sm text-zinc-500">Every result keeps its exact prompt, model, cost, output, and reusable input lineage.</p></div>
                <div class="flex flex-wrap items-center gap-2">
                  <% if (plan.generations.some(generation => generation.resources.some(resource => resource.role === 'Output'))) { %><a href="<%= basePath %>/plans/<%= plan.id %>/generations.zip" class="ghost-button h-11 px-4 text-xs"><i data-lucide="file-archive" class="h-4 w-4"></i>Download all generations</a><% } %>
                  <% if (permissions.canEditPlans) { %><button id="addGenerationButton" class="primary-button h-11 px-5"><i data-lucide="plus" class="h-4 w-4"></i>Add generation</button><% } %>
                </div>
              </div>

              <div class="mt-5 grid gap-4 md:grid-cols-2">
                <% if (plan.generations.length) { plan.generations.forEach((generation, index) => { const outputs = generation.resources.filter(resource => resource.role === 'Output'); const output = outputs[0]; const isSelected = generation.id === plan.selected_generation_id; %>
                  <article class="generation-card group relative overflow-hidden rounded-3xl border <%= isSelected ? 'border-acid/25 bg-acid/[0.025]' : 'border-white/[0.07] bg-[#101113]' %>">
                    <button type="button" class="generation-open-button block w-full text-left" data-generation-id="<%= generation.id %>">
                      <div class="relative aspect-video overflow-hidden bg-black/35">
                        <% if (output && output.kind === 'image' && !output.mime_type.includes('svg')) { %><img src="<%= output.content_url %>" alt="<%= generation.version_label %> output" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]" />
                        <% } else if (output && output.kind === 'video') { %><video src="<%= output.content_url %>" muted preload="metadata" class="h-full w-full object-cover"></video>
                        <% } else { %><div class="absolute inset-0 grid place-items-center bg-[#17191b] text-xs text-zinc-500">No output file</div><% } %>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-black/20"></div>
                        <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-2 p-3">
                          <div class="flex items-center gap-1.5">
                            <span class="rounded-full bg-black/65 px-2.5 py-1 text-[9px] font-semibold uppercase tracking-wider backdrop-blur"><%= generation.version_label %></span>
                            <span class="status-pill backdrop-blur <%= generation.status === 'Approved' ? 'border-lime-400/25 bg-lime-400/10 text-lime-300' : 'border-amber-400/25 bg-amber-400/10 text-amber-300' %>"><%= generation.status || 'WIP' %></span>
                          </div>
                          <% if (isSelected) { %><span class="inline-flex items-center gap-1 rounded-full border border-acid/25 bg-black/65 px-2.5 py-1 text-[9px] font-semibold text-acid backdrop-blur"><i data-lucide="badge-check" class="h-3 w-3"></i>Selected final</span><% } else { %><span class="rounded-full bg-black/65 px-2.5 py-1 text-[9px] font-semibold text-zinc-300 backdrop-blur"><%= generation.platform_name || 'Platform not recorded' %></span><% } %>
                        </div>
                        <div class="absolute bottom-3 left-3 flex flex-wrap gap-1.5"><span class="rounded-full border border-white/10 bg-black/60 px-2 py-1 text-[8px] text-white/70 backdrop-blur"><%= outputs.length %> output<%= outputs.length === 1 ? '' : 's' %></span></div>
                      </div>
                      <div class="p-5">
                        <div class="mb-2 text-xs font-semibold text-acid"><%= plan.is_test_plan ? 'Test plan' : `#Seq ${generation.sequence_number} / #Shot ${generation.shot_number}` %></div>
                        <div class="flex items-start justify-between gap-4"><div><h3 class="text-base font-semibold"><%= generation.version_label %></h3><div class="mt-1 text-[10px] text-zinc-600"><%= generation.model %> &middot; <%= generation.created_at.slice(0,10) %></div></div><div class="text-sm font-semibold text-acid"><%= formatCost(generation.generation_cost) %></div></div>
                        <p class="mt-4 line-clamp-2 text-xs leading-5 text-zinc-500"><%= generation.notes || generation.prompt || 'No notes recorded.' %></p>
                        <div class="mt-4 flex items-center justify-between border-t border-white/[0.06] pt-3 text-[10px]"><span class="text-zinc-600"><%= Number(generation.total_tokens || 0).toLocaleString() %> tokens</span><span class="font-semibold text-zinc-300"><%= formatCost(generation.generation_cost) %></span></div>
                      </div>
                    </button>
                    <% if (output && ['image', 'video'].includes(output.kind)) { %>
                      <div class="absolute right-3 top-14 z-10 flex items-center gap-1.5 rounded-full border border-white/10 bg-black/75 p-1 shadow-lg backdrop-blur-lg">
                        <a href="<%= output.download_url %>" class="icon-button h-8 w-8 border-0 bg-transparent text-white hover:text-acid" aria-label="Download <%= output.original_name %>" title="Download output"><i data-lucide="download" class="h-4 w-4"></i></a>
                        <% if (permissions.canEditPlans) { %><button type="button" class="delete-generation-output-button icon-button h-8 w-8 border-0 bg-transparent text-red-300/75 hover:text-red-200" data-resource-id="<%= output.id %>" data-resource-name="<%= output.original_name %>" aria-label="Delete <%= output.original_name %>" title="Delete output"><i data-lucide="trash-2" class="h-4 w-4"></i></button><% } %>
                      </div>
                    <% } %>
                    <div class="flex items-center gap-2 border-t border-white/[0.06] p-3">
                      <% if (permissions.canSetCurrentFinal && !isSelected) { %><button type="button" class="select-generation-button ghost-button h-9 flex-1 text-xs" data-generation-id="<%= generation.id %>"><i data-lucide="badge-check" class="h-3.5 w-3.5"></i>Set as current final</button><% } %>
                      <% if (permissions.canApprovePlans) { %>
                        <button type="button" class="toggle-generation-status-button <%= generation.status === 'Approved' ? 'ghost-button text-amber-300/80 hover:text-amber-200' : 'primary-button' %> h-9 px-3 text-xs" data-generation-id="<%= generation.id %>" data-status="<%= generation.status === 'Approved' ? 'WIP' : 'Approved' %>" title="<%= generation.status === 'Approved' ? 'Mark as WIP' : 'Approve generation' %>">
                          <i data-lucide="<%= generation.status === 'Approved' ? 'clock' : 'circle-check' %>" class="h-3.5 w-3.5"></i><span><%= generation.status === 'Approved' ? 'Mark WIP' : 'Approve' %></span>
                        </button>
                      <% } %>
                    </div>
                  </article>
                <% }) } else { %>
                  <div class="md:col-span-2 rounded-3xl border border-dashed border-white/10 py-20 text-center"><i data-lucide="image-plus" class="mx-auto h-8 w-8 text-zinc-700"></i><div class="mt-4 text-sm font-semibold">No generations yet</div><div class="mt-1 text-xs text-zinc-600">Log the first result with its prompt, output, cost, and input resources.</div><% if (permissions.canEditPlans) { %><button type="button" class="generation-empty-add ghost-button mt-5 h-10 px-4 text-xs">Add first generation</button><% } %></div>
                <% } %>
              </div>
            </section>

            <section class="shot-panel hidden" data-panel="assets">
              <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                <div><div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-600">Plan preparation</div><h2 class="mt-2 text-2xl font-semibold tracking-tight">Brief, notes, and assets</h2><p class="mt-2 max-w-2xl text-sm text-zinc-500">Keep the shot brief and reusable inputs together before creating generations.</p></div>
                <div class="flex flex-wrap items-center gap-2"><div class="rounded-full border border-white/[0.08] px-3 py-1.5 text-[10px] text-zinc-500"><%= plan.resource_count %> assets &middot; <%= formatBytes(plan.resource_bytes) %></div><% if (plan.assets.length) { %><a href="<%= basePath %>/plans/<%= plan.id %>/assets.zip" class="ghost-button h-9 px-3 text-xs"><i data-lucide="file-archive" class="h-3.5 w-3.5"></i>Download all assets</a><select id="resourceFilter" class="field h-9 w-auto min-w-36 py-0 pl-3.5 pr-8 text-xs"><option value="all">All asset types</option><% generationResourceRoles.forEach(role => { %><option value="<%= role %>"><%= role %></option><% }) %></select><% } %></div>
              </div>

              <form id="assetBriefForm" class="mt-6 rounded-3xl border border-white/[0.08] bg-[#101113] p-4 sm:p-5">
                <label><span class="field-label">Brief / Notes</span><textarea id="assetBriefNotes" class="field min-h-32 resize-y text-sm leading-6" maxlength="20000" placeholder="Describe the shot, creative intent, requirements, continuity notes, or anything the team should know." <%= permissions.canEditPlans ? '' : 'readonly' %>><%= plan.description %></textarea></label>
                <% if (permissions.canEditPlans) { %><div class="mt-3 flex justify-end"><button type="submit" class="ghost-button h-10 px-4 text-xs"><i data-lucide="save" class="h-3.5 w-3.5"></i><span>Save brief / notes</span></button></div><% } %>
              </form>

              <% if (permissions.canEditPlans) { %>
                <form id="resourceUploadForm" data-max-upload-bytes="<%= maxUploadBytes %>" class="mt-6 rounded-3xl border border-white/[0.08] bg-[#101113] p-4 sm:p-5">
                  <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_220px]">
                    <div id="resourceDropZone" data-file-drop-zone role="button" tabindex="0" class="group grid min-h-40 cursor-pointer place-items-center rounded-2xl border border-dashed border-white/15 bg-black/20 p-6 text-center outline-none transition hover:border-acid/40 hover:bg-acid/[0.025] focus:border-acid/50 focus:ring-2 focus:ring-acid/10">
                      <input id="resourceFileInput" name="file" type="file" multiple class="hidden" />
                      <div><span class="mx-auto grid h-11 w-11 place-items-center rounded-2xl border border-white/10 bg-white/[0.04] text-zinc-500 transition group-hover:border-acid/20 group-hover:text-acid"><i data-lucide="upload-cloud" class="h-5 w-5"></i></span><div class="mt-4 text-sm font-semibold text-zinc-300">Drop files here or choose from your computer</div><div class="mt-1.5 text-[11px] text-zinc-600">Images, video, audio, documents, archives, and source files &middot; up to <%= formatBytes(maxUploadBytes) %> each</div></div>
                    </div>
                    <div class="flex flex-col gap-3"><label><span class="field-label">Asset / Media type</span><select id="assetResourceRole" class="field"><% generationResourceRoles.forEach(role => { %><option <%= role === 'First Frame' ? 'selected' : '' %>><%= role %></option><% }) %></select></label><div class="rounded-2xl border border-white/[0.06] bg-black/20 p-4 text-[11px] leading-5 text-zinc-600">Choose the role this upload will have when it is reused in a generation, such as First Frame, Last Frame, Depth Map, or another configured type.</div></div>
                  </div>
                  <div id="resourceUploadQueue" class="mt-4 hidden space-y-2 border-t border-white/[0.07] pt-4"></div>
                </form>
              <% } %>

              <div id="resourceGrid" class="mt-6 grid gap-4 sm:grid-cols-2 2xl:grid-cols-3">
                <% if (plan.assets.length) { plan.assets.forEach(resource => { %>
                  <article class="resource-card group overflow-hidden rounded-3xl border border-white/[0.07] bg-[#101113]" data-resource-card="<%= resource.id %>" data-resource-role="<%= resource.asset_role %>">
                    <div class="relative aspect-video overflow-hidden bg-black/30">
                      <% if (resource.kind === 'image' && !resource.mime_type.includes('svg')) { %><button type="button" class="plan-image-viewer-button block h-full w-full" data-resource-id="<%= resource.id %>" aria-label="View <%= resource.original_name %>"><img src="<%= resource.content_url %>" alt="<%= resource.original_name %>" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]" /></button>
                      <% } else if (resource.kind === 'video') { %><video src="<%= resource.content_url %>" controls preload="metadata" class="h-full w-full bg-black object-contain"></video>
                      <% } else if (resource.kind === 'audio') { %><div class="flex h-full flex-col items-center justify-center p-5"><span class="grid h-14 w-14 place-items-center rounded-2xl bg-violet-400/10 text-violet-300"><i data-lucide="audio-lines" class="h-6 w-6"></i></span><audio src="<%= resource.content_url %>" controls preload="metadata" class="mt-5 h-9 w-full"></audio></div>
                      <% } else { %><a href="<%= resource.download_url %>" class="flex h-full flex-col items-center justify-center text-zinc-700 transition hover:text-zinc-400"><span class="grid h-16 w-16 place-items-center rounded-2xl border border-white/[0.07] bg-white/[0.025]"><i data-lucide="<%= resourceIcons[resource.kind] || resourceIcons.other %>" class="h-7 w-7"></i></span><span class="mt-3 text-[9px] font-semibold uppercase tracking-[0.14em]"><%= resource.kind %></span></a><% } %>
                      <span class="absolute left-3 top-3 rounded-full border border-white/10 bg-black/65 px-2.5 py-1 text-[9px] font-semibold uppercase tracking-[0.1em] text-zinc-300 backdrop-blur"><%= resource.asset_role %></span>
                      <% if (resource.generation_usage_count) { %><span class="absolute right-3 top-3 rounded-full border border-acid/15 bg-black/65 px-2.5 py-1 text-[9px] text-acid backdrop-blur">Used in <%= resource.generation_usage_count %> version<%= resource.generation_usage_count === 1 ? '' : 's' %></span><% } %>
                    </div>
                    <div class="p-4"><div class="truncate text-sm font-semibold text-zinc-200" title="<%= resource.original_name %>"><%= resource.original_name %></div><div class="mt-1.5 text-[10px] text-zinc-600"><%= formatBytes(resource.size_bytes) %> &middot; <%= resource.created_at.slice(0,10) %></div><% if (resource.notes) { %><p class="mt-3 line-clamp-2 text-[11px] leading-5 text-zinc-500"><%= resource.notes %></p><% } %><div class="mt-4 flex items-center gap-2 border-t border-white/[0.06] pt-3"><% if (resource.kind === 'image' && !resource.mime_type.includes('svg')) { %><button type="button" class="plan-image-viewer-button ghost-button h-8 px-3 text-[10px]" data-resource-id="<%= resource.id %>"><i data-lucide="expand" class="h-3.5 w-3.5"></i>Open</button><% } %><a href="<%= resource.download_url %>" class="icon-button h-8 w-8" aria-label="Download <%= resource.original_name %>"><i data-lucide="download" class="h-3.5 w-3.5"></i></a><% if (permissions.canEditPlans) { %><button type="button" class="resource-delete-button icon-button ml-auto h-8 w-8 text-zinc-600 hover:border-red-300/20 hover:text-red-300" data-resource-id="<%= resource.id %>" data-resource-name="<%= resource.original_name %>" aria-label="Remove <%= resource.original_name %>"><i data-lucide="trash-2" class="h-3.5 w-3.5"></i></button><% } %></div></div>
                  </article>
                <% }) } else { %><div class="sm:col-span-2 2xl:col-span-3 rounded-3xl border border-dashed border-white/10 py-20 text-center"><i data-lucide="folder-open" class="mx-auto h-8 w-8 text-zinc-700"></i><div class="mt-4 text-sm font-semibold">No plan assets yet</div><div class="mt-1 text-xs text-zinc-600">Upload a first frame, last frame, depth map, reference, or other production asset.</div></div><% } %>
              </div>
            </section>

          </div>

          <aside class="space-y-5 xl:sticky" style="top:calc(150px + var(--shot-navigation-height, 0px))">
            <section class="rounded-3xl border border-white/[0.08] bg-[#101113] p-5"><div class="flex items-center justify-between"><div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-600">Workflow</div><i data-lucide="git-branch" class="h-4 w-4 text-zinc-700"></i></div><% if (allowedStatuses.length) { %><label class="mt-4 block"><span class="field-label">Status</span><select id="shotStatusSelect" class="field h-11"><% if (!allowedStatuses.includes(plan.status)) { %><option selected disabled><%= plan.status %></option><% } %><% allowedStatuses.forEach(status => { %><option <%= status === plan.status ? 'selected' : '' %>><%= status %></option><% }) %></select></label><% } else { %><div class="mt-4"><span class="field-label">Status</span><span class="status-pill <%= statusStyles[plan.status] || statusStyles.WIP %>"><%= plan.status %></span></div><% } %><div class="mt-5 flex items-center gap-3 rounded-2xl border border-white/[0.06] bg-black/20 p-3"><div class="grid h-9 w-9 place-items-center rounded-full bg-white/[0.08] text-[10px] font-bold"><%= ownerInitials %></div><div><div class="text-xs font-semibold"><%= plan.owner %></div><div class="mt-1 text-[10px] text-zinc-600">Shot owner</div></div></div><div class="mt-4 border-t border-white/[0.07] pt-4"><div class="field-label">Assigned users</div><div class="text-xs text-zinc-400"><%= plan.assignees.length ? plan.assignees.map(user => user.display_name).join(', ') : 'No users assigned' %></div><% if (permissions.canAssignPlans) { %><button id="assignPlanButton" type="button" data-plan-id="<%= plan.id %>" class="ghost-button mt-3 h-9 w-full text-xs"><i data-lucide="users" class="h-3.5 w-3.5"></i>Manage assignments</button><% } %></div><% if (plan.approval && plan.status === 'Approved') { %><div class="mt-4 rounded-2xl border border-acid/15 bg-acid/[0.035] p-3"><div class="flex items-center gap-2 text-xs font-semibold text-acid"><i data-lucide="badge-check" class="h-4 w-4"></i>Approved by <%= plan.approval.approved_by_name %></div><div class="mt-1 text-[9px] text-zinc-600"><%= plan.approval.generation_label %> · <%= plan.approval.approved_at.slice(0,16).replace('T',' ') %></div></div><% } %><% if (permissions.canApprovePlans && plan.status !== 'Approved') { %><button id="approveShotButton" class="primary-button mt-4 h-11 w-full"><i data-lucide="circle-check" class="h-4 w-4"></i>Approve shot</button><% } %></section>
            <section class="rounded-3xl border border-white/[0.08] bg-[#101113] p-5"><div class="flex items-center justify-between"><div><div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-600">Version health</div><div class="mt-1 text-xs text-zinc-500">Generation coverage</div></div><div class="quality-ring grid h-16 w-16 place-items-center rounded-full" style="--score:<%= Math.round(Number(plan.quality || 0) * 20) %>"><div class="grid h-[54px] w-[54px] place-items-center rounded-full bg-[#101113] text-sm font-bold"><%= plan.quality ? plan.quality.toFixed(1) : '—' %></div></div></div><div class="mt-5 grid grid-cols-2 gap-3"><div class="rounded-xl bg-white/[0.025] p-3"><div class="text-[9px] uppercase tracking-wider text-zinc-700">Versions</div><div class="mt-1 text-lg font-semibold"><%= plan.generation_count %></div></div><div class="rounded-xl bg-white/[0.025] p-3"><div class="text-[9px] uppercase tracking-wider text-zinc-700">Files linked</div><div class="mt-1 text-lg font-semibold"><%= plan.generations.reduce((total, generation) => total + generation.resources.length, 0) %></div></div></div></section>
            <section class="rounded-3xl border border-white/[0.08] bg-[#101113] p-5"><div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-600">Shot metadata</div><dl class="mt-4 space-y-3 text-xs"><% [['Scene',plan.scene_name],...(plan.is_test_plan ? [['Type','Test plan']] : [['#Seq',plan.sequence_number],['#Shot',plan.shot_number]]),['Priority',plan.priority],['Created',plan.created_at.slice(0,10)]].forEach(([label,value]) => { %><div class="flex items-center justify-between gap-4"><dt class="text-zinc-600"><%= label %></dt><dd class="truncate font-medium text-zinc-300"><%= value %></dd></div><% }) %></dl></section>
          </aside>
        </div>
      </main>
    </div>

    <div id="generationModal" class="modal-backdrop fixed inset-0 z-[60] hidden items-center justify-center bg-black/75 p-3 sm:p-6" role="dialog" aria-modal="true" aria-labelledby="generationModalTitle">
      <div class="modal-card flex max-h-[94vh] w-full max-w-6xl flex-col overflow-hidden rounded-[28px] border border-white/10 bg-[#111214] shadow-float">
        <header class="flex shrink-0 items-center justify-between border-b border-white/[0.07] px-5 py-4 sm:px-6"><div><div class="text-[9px] font-semibold uppercase tracking-[0.15em] text-acid">Generation detail</div><h2 id="generationModalTitle" class="mt-1 text-lg font-semibold">Generation</h2></div><button type="button" class="generation-modal-close icon-button" aria-label="Close generation detail"><i data-lucide="x" class="h-4 w-4"></i></button></header>
        <div id="generationDetailBody" class="min-h-0 flex-1 overflow-y-auto"></div>
        <footer class="flex shrink-0 flex-wrap items-center justify-end gap-2 border-t border-white/[0.07] px-5 py-4 sm:px-6"><% if (permissions.canDeletePlans) { %><button id="deleteGenerationButton" type="button" class="mr-auto h-10 rounded-full border border-red-300/15 px-4 text-xs text-red-300/65 transition hover:text-red-200"><i data-lucide="trash-2" class="mr-1 inline h-3.5 w-3.5"></i>Delete generation</button><% } %><button id="editGenerationButton" type="button" class="ghost-button h-10 px-4 text-xs"><i data-lucide="pencil" class="h-3.5 w-3.5"></i>Edit details & resources</button><button id="selectGenerationButton" type="button" class="ghost-button h-10 px-4 text-xs"><i data-lucide="badge-check" class="h-3.5 w-3.5"></i>Set as current final</button><% if (permissions.canApprovePlans) { %><button id="approveGenerationButton" type="button" class="primary-button h-10 px-4 text-xs"><i data-lucide="circle-check" class="h-3.5 w-3.5"></i><span id="approveGenerationButtonText">Approve generation</span></button><% } %></footer>
      </div>
    </div>

    <div id="generationMediaModal" class="modal-backdrop fixed inset-0 z-[75] hidden items-center justify-center bg-black/90 p-3 sm:p-6" role="dialog" aria-modal="true" aria-labelledby="generationMediaTitle">
      <div class="modal-card flex max-h-[95vh] w-full max-w-7xl flex-col overflow-hidden rounded-[26px] border border-white/10 bg-[#0c0d0f] shadow-float">
        <header class="flex shrink-0 items-center justify-between gap-3 border-b border-white/[0.08] px-4 py-3 sm:px-5"><div class="min-w-0"><div class="text-[9px] font-semibold uppercase tracking-[0.15em] text-acid">Generation media</div><h2 id="generationMediaTitle" class="mt-1 truncate text-sm font-semibold text-white"></h2></div><div class="flex shrink-0 items-center gap-2"><a id="generationMediaDownload" class="ghost-button h-9 px-3 text-xs" href="#"><i data-lucide="download" class="h-4 w-4"></i><span class="hidden sm:inline">Download</span></a><% if (permissions.canEditPlans) { %><button id="generationMediaDelete" type="button" class="icon-button h-9 w-9 text-red-300/75 hover:text-red-200" aria-label="Delete generation output" title="Delete output"><i data-lucide="trash-2" class="h-4 w-4"></i></button><% } %><button type="button" class="generation-media-close icon-button" aria-label="Close media viewer"><i data-lucide="x" class="h-4 w-4"></i></button></div></header>
        <div id="generationMediaBody" class="flex min-h-0 flex-1 items-center justify-center overflow-auto bg-black/70"></div>
        <footer class="flex shrink-0 justify-center gap-2 border-t border-white/[0.08] bg-black/30 px-4 py-3"><button id="generationMediaFullscreen" type="button" class="ghost-button h-9 px-4 text-xs"><i data-lucide="maximize-2" class="h-3.5 w-3.5"></i>Full screen</button></footer>
      </div>
    </div>

    <div id="generationEditorModal" class="modal-backdrop fixed inset-0 z-[65] hidden items-center justify-center bg-black/80 p-3 sm:p-6" role="dialog" aria-modal="true" aria-labelledby="generationEditorTitle">
      <form id="generationEditorForm" class="modal-card flex max-h-[94vh] w-full max-w-5xl flex-col overflow-hidden rounded-[28px] border border-white/10 bg-[#111214] shadow-float">
        <header class="flex shrink-0 items-center justify-between border-b border-white/[0.07] px-5 py-4 sm:px-6"><div><div class="text-[9px] font-semibold uppercase tracking-[0.15em] text-acid">Version record</div><h2 id="generationEditorTitle" class="mt-1 text-lg font-semibold">Add generation</h2></div><button type="button" class="generation-editor-close icon-button" aria-label="Close generation editor"><i data-lucide="x" class="h-4 w-4"></i></button></header>
        <div class="min-h-0 flex-1 overflow-y-auto p-5 sm:p-6">
          <input id="generationIdInput" type="hidden" />
          <% if (plan.is_test_plan) { %><p class="mb-5 rounded-2xl border border-acid/15 bg-acid/[0.04] p-3 text-xs text-zinc-400"><span class="font-semibold text-acid">Test plan</span> · This plan does not use sequence or shot numbers.</p><% } else { %><div class="mb-4 grid grid-cols-2 gap-4"><label><span class="field-label">#Seq · Sequence *</span><input id="generationSequenceNumberInput" type="text" maxlength="100" class="field text-2xl" required /></label><label><span class="field-label">#Shot · Plan / Shot number *</span><input id="generationShotNumberInput" type="number" min="1" max="1000000" step="1" class="field text-2xl" required /></label></div><p class="mb-5 text-xs text-zinc-500">Required for every generation and upload. Identifiers must match this shot (#Seq <%= plan.sequence_number %> / #Shot <%= plan.shot_number %>) and are locked once saved.</p><% } %>
          <div class="grid gap-4 sm:grid-cols-[140px_140px_minmax(0,1fr)_200px]"><label><span class="field-label">Generation version</span><div class="relative"><span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-semibold text-zinc-500">v</span><input id="generationVersionNumberInput" type="number" min="1" max="1000000" step="1" class="field pl-8" required /></div></label><label><span class="field-label">Status</span><select id="generationStatusInput" class="field"><option value="WIP">WIP</option><option value="Approved" <%= permissions.canApprovePlans ? '' : 'disabled' %>>Approved</option></select></label><label><span class="field-label">AI model</span><select id="generationModelInput" class="field" required><% generationCatalogs.models.forEach(model => { %><option><%= model.name %></option><% }) %></select></label><label><span class="field-label">Seed <span class="normal-case tracking-normal text-zinc-700">optional</span></span><input id="generationSeedInput" class="field" maxlength="240" /></label></div>
          <div class="mt-4 grid gap-4 lg:grid-cols-2"><label><span class="field-label">Prompt</span><textarea id="generationPromptInput" class="field h-40 resize-y text-xs leading-6" maxlength="20000" placeholder="The exact prompt sent to the model"></textarea></label><div class="space-y-4"><label><span class="field-label">Negative prompt <span class="normal-case tracking-normal text-zinc-700">optional</span></span><textarea id="generationNegativePromptInput" class="field h-[74px] resize-y text-xs" maxlength="10000"></textarea></label><label><span class="field-label">Generation notes <span class="normal-case tracking-normal text-zinc-700">optional</span></span><textarea id="generationNotesInput" class="field h-[74px] resize-y text-xs" maxlength="5000" placeholder="What changed, what worked, what failed"></textarea></label></div></div>

          <section class="mt-6 rounded-3xl border border-white/[0.07] bg-black/20 p-4 sm:p-5"><div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-center"><div><div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-500">Generation cost estimate</div><p class="mt-1 text-[11px] text-zinc-700">Token price is copied from the platform when this generation is saved and will never change retroactively.</p></div><div id="generationCostPreview" class="text-lg font-semibold text-acid">$0.0000</div></div><div class="mt-4 grid gap-3 sm:grid-cols-3"><label><span class="field-label">Generation platform</span><select id="generationPlatformInput" class="field" required><% generationCatalogs.platforms.forEach(platform => { %><option value="<%= platform.id %>"><%= platform.name %></option><% }) %></select></label><label><span class="field-label">Tokens / credits used</span><input id="generationTokenCountInput" type="number" min="0" step="1" class="field" value="0" /></label><div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-3"><div class="text-[9px] uppercase tracking-wider text-zinc-700">Price snapshot</div><div id="generationTokenPricePreview" class="mt-2 text-sm font-semibold text-zinc-300">$0.000000 / token</div><div id="generationPriceNote" class="mt-1 text-[9px] leading-4 text-zinc-700">Current Admin price</div></div></div></section>

          <section class="mt-6 rounded-3xl border border-white/[0.07] bg-black/20 p-4 sm:p-5">
            <div class="flex items-center gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl border border-acid/15 bg-acid/[0.06] text-acid"><i data-lucide="clapperboard" class="h-5 w-5"></i></span><div><div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-acid">Generation outputs</div><h3 class="mt-0.5 text-base font-semibold text-zinc-100">Upload results for this version</h3></div></div>
            <p class="mt-3 text-[11px] leading-5 text-zinc-500">Select multiple images or videos generated from the same prompt. Each file stays linked to this one generation.</p>
            <label id="generationOutputDropZone" data-file-drop-zone for="generationUploadInput" tabindex="0" class="group mt-4 flex min-h-44 cursor-pointer flex-col items-center justify-center rounded-[22px] border border-dashed border-acid/20 bg-[radial-gradient(circle_at_50%_0%,rgba(214,255,69,0.075),transparent_68%)] px-5 py-6 text-center transition hover:border-acid/45 hover:bg-acid/[0.035] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-acid/40">
              <input id="generationUploadInput" type="file" multiple class="hidden" aria-label="Upload generation outputs" />
              <span class="grid h-12 w-12 place-items-center rounded-2xl border border-acid/20 bg-acid/10 text-acid shadow-[0_0_24px_rgba(214,255,69,0.08)] transition group-hover:scale-105"><i data-lucide="upload-cloud" class="h-5 w-5"></i></span>
              <span class="mt-4 text-sm font-semibold text-zinc-100">Drop your output here</span>
              <span class="mt-1 text-[11px] text-zinc-500">or <span class="font-semibold text-acid">browse your computer</span></span>
              <span class="mt-3 text-[10px] text-zinc-700">Multiple output files · up to <%= formatBytes(maxUploadBytes) %> each</span>
            </label>
            <div id="generationSelectedOutput" class="mt-4 hidden" aria-live="polite"></div>
            <p id="generationUploadStatus" class="mt-3 text-[11px] text-zinc-500" role="status">Your uploaded file will be linked when you save the generation.</p>
          </section>
        </div>
        <footer class="flex shrink-0 items-center justify-end gap-2 border-t border-white/[0.07] px-5 py-4 sm:px-6"><button type="button" class="generation-editor-close ghost-button h-10 px-4 text-xs">Cancel</button><button id="saveGenerationButton" type="submit" class="primary-button h-10 px-5 text-xs"><i data-lucide="save" class="h-3.5 w-3.5"></i>Save generation</button></footer>
      </form>
    </div>

    <div id="shotToast" class="pointer-events-none fixed bottom-5 left-1/2 z-[80] flex -translate-x-1/2 translate-y-4 items-center gap-2 rounded-full border border-white/10 bg-zinc-100 px-4 py-2.5 text-xs font-semibold text-black opacity-0 shadow-float transition-all"><i data-lucide="check" class="h-4 w-4"></i><span></span></div>
    <script>
      window.__AI_HUB_PLAN__ = <%- serializedPlan %>;
      window.__AI_HUB_NAVIGATION_PLANS__ = <%- serializedNavigationPlans %>;
      window.__AI_HUB_CURRENT_USER__ = <%- serializedUser %>;
      window.__AI_HUB_PERMISSIONS__ = <%- serializedPermissions %>;
      window.__AI_HUB_MAX_UPLOAD_BYTES__ = <%= maxUploadBytes %>;
      window.__AI_HUB_RESOURCE_ROLES__ = <%- JSON.stringify(generationResourceRoles).replaceAll('<', '\\u003c') %>;
      window.__AI_HUB_GENERATION_CATALOGS__ = <%- JSON.stringify(generationCatalogs).replaceAll('<', '\\u003c') %>;
    </script>
    <script src="<%= basePath %>/vendor/lucide/lucide.js"></script>
    <script src="<%= basePath %>/js/shot-navigation.js" defer></script>
    <script src="<%= basePath %>/js/plan-detail.js" defer></script>
  </body>
</html>
