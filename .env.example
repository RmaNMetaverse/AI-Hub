# Optional: use an explicit Linux directory instead of Docker's named media volume.
# AI_HUB_MEDIA_STORAGE=/srv/ai-hub/storage
AI_HUB_MEDIA_STORAGE=ai-hub-media

# Maximum size of one uploaded file in bytes. Default: 20 GiB.
AI_HUB_MAX_UPLOAD_BYTES=21474836480

# Optional: set a URL subpath prefix if serving under a reverse proxy subdirectory (e.g. /AIHub).
# Leave empty or omitted for root domain hosting.
# BASE_PATH=/AIHub
